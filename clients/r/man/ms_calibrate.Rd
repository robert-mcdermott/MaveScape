\alias{ms_calibrate}
\title{Calibrate a run against a control set}
\usage{
ms_calibrate(abnormal = NULL, condition = NULL, control_set = NULL, curves = NULL, error = NULL, name = NULL, normal = NULL, rule = NULL, run = NULL, samples = NULL, seed = NULL, side = NULL, ms = ms_default())
}
\arguments{
\item{abnormal}{rule given: the abnormal threshold (a score at or beyond it, on the abnormal side, is abnormal-like). Optional; a number.}
\item{condition}{The run's condition, counted from 0 (0 if not given). Optional; a whole number.}
